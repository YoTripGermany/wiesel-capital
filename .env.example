# Lokale Einstellungen: diese Datei als ".env" kopieren und ausfüllen.
# Auf Railway stehen dieselben Werte unter "Variables" — dort keine .env anlegen.

# Postgres-Verbindung. Ohne sie läuft die Website normal, nur der Blog ist aus.
# Auf Railway: ${{Postgres.DATABASE_URL}}
DATABASE_URL=

# Passwort für die Redaktion unter /admin. Lang und nirgends sonst verwendet.
ADMIN_PASSWORD=

# Öffentliche Adresse der Website (für Canonical-Links, Open Graph und Sitemap).
SITE_URL=https://wiesel-capital.com
